# =============================================================================
# EasyPanel production (phone-app service)
# =============================================================================
# IMPORTANT (Option A / shared data with web):
# - Use the SAME Postgres as Django web (db_solar_v2)
# - Host must be the EasyPanel Postgres service name: database
# - Do NOT use db_solar_database (stale / No route to host)
# - Django owns migrations; phone only adds IF NOT EXISTS columns at boot
# =============================================================================
DATABASE_URL=postgresql://heramb:Heramb2023@database:5432/db_solar_v2
PORT=8080
NODE_ENV=production

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Future Option A (HTTP to Django) — not required while phone uses shared DB:
# DJANGO_BASE_URL=https://app.db-solar.co.in

# MEDIA_ROOT=/path/on/vps/media
# Public origin used to build absolute image URLs (no trailing slash)
MEDIA_BASE_URL=http://72.60.98.248:8080

# =============================================================================
# Local Windows development — uncomment for PC-only testing
# =============================================================================
# DATABASE_URL=postgresql://admin:root@localhost:5432/db_solar_v2
# PORT=3000
# NODE_ENV=development

# Email Configuration (for password reset — use a Gmail App Password, not login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# SMTP_FROM="DB Solar" <your-email@gmail.com>

# Firebase Admin SDK (for push notifications)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
